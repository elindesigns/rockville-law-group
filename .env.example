# Copy this file to .env (not committed) and fill in a real GA4
# Measurement ID to activate analytics. Leave unset in any
# environment where analytics should stay off (e.g. local dev).
VITE_GA4_MEASUREMENT_ID=

# Formspree form IDs (from formspree.io — Settings > the form's
# endpoint, a short ID like "xanybkwd", not the full URL). Each form
# falls back to a mailto: link until its ID is set here — nothing
# breaks if these stay empty. The two are separate so consultation
# requests and attorney coverage requests can route differently if
# desired; point both at the same form if that's not needed.
VITE_FORMSPREE_CONSULTATION_ID=
VITE_FORMSPREE_ATTORNEY_ID=
